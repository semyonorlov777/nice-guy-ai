{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-env-to-worktree.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-book-spawn-task.ps1\""
          }
        ]
      }
    ]
  }
}
