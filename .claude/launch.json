{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "demo-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server", ".", "-p", "4477", "-c-1", "--silent"],
      "port": 4477,
      "autoPort": true
    },
    {
      "name": "next-dev-voice",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8787/api/practice/ws", "npm", "run", "dev", "--", "-p", "3002"],
      "port": 3002
    }
  ]
}
