{
  "name": "voice-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "start": "node --import tsx src/server.ts",
    "fake-client": "tsx --env-file-if-exists=.env.local scripts/fake-client.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
